# Charmtone Color Theme Environment Variables
# Based on Charm Crush color palette from github.com/charmbracelet/crush

# Background Colors
export BG1="#201F26"     # Pepper - Main background
export BG2="#2d2c35"     # BBQ - Secondary background
export BG3="#3A3943"     # Charcoal - Subtle background
export BG4="#4D4C57"     # Iron - Overlay background

# Foreground Colors
export BASE="#DFDBDD"    # Ash - Main text
export BASE_DIM="#858392" # Squid - Muted text
export SMOKE="#BFBCC8"   # Smoke - Half-muted text
export OYSTER="#605F6B"  # Oyster - Subtle UI text
export SALT="#F1EFEF"    # Salt - Selected text

# Accent Colors
export ACT1="#6B50FF"    # Charple - Primary accent
export ACT2="#FF60FF"    # Dolly - Secondary accent
export ACT3="#68FFD6"    # Bok - Tertiary accent
export ACCENT="#E8FE96"  # Zest - Highlight accent

# Status Colors
export SUCCESS="#12C78F" # Guac - Success
export ERR="#EB4268"     # Sriracha - Error
export WARNING="#E8FE96" # Zest - Warning
export INFO="#00A4FF"    # Malibu - Info

# Syntax Highlighting Colors
export KEYWORD="#6B50FF" # Charple - Keywords
export FUNC="#FF60FF"    # Dolly - Functions
export STR="#68FFD6"     # Bok - Strings
export CONST="#00A4FF"   # Malibu - Constants
export COMMENT="#858392" # Squid - Comments
export TYPE="#C259FF"    # Violet - Types
export VAR="#F5EF34"     # Mustard - Variables

# UI Element Colors
export BORDER="#6B50FF"  # Charple - Focused border
export BORDER_INACTIVE="#4D4C57" # Iron - Inactive border
export HIGHLIGHT="#4D4C57" # Iron - Highlight
export HIGHLIGHT_DIM="#3A3943" # Charcoal - Dim highlight
export CURSOR="#6B50FF"  # Charple - Cursor
export SEL_BG="#6B50FF"  # Charple - Selection background
export SEL_FG="#F1EFEF"  # Salt - Selection foreground

# Additional Colors for Extended Use
export BUTTER="#FFFAF1"  # Pure white
export SARDINE="#4FBEFE" # Light blue
export DAMSON="#007AB8"  # Dark blue
export MUSTARD="#F5EF34" # Yellow
export JULEP="#00FFB2"   # Green
export CORAL="#FF577D"   # Red
export SALMON="#FF7F90"  # Light red
export VIOLET="#C259FF"  # Purple
export PLUM="#9953FF"    # Light purple

# RGB Values (for applications that need RGB format)
export BG1_RGB="32,31,38"
export BG2_RGB="45,44,53"
export BG3_RGB="58,57,67"
export BG4_RGB="77,76,87"
export BASE_RGB="223,219,221"
export BASE_DIM_RGB="133,131,146"
export SMOKE_RGB="191,188,200"
export OYSTER_RGB="96,95,107"
export SALT_RGB="241,239,239"
export ACT1_RGB="107,80,255"
export ACT2_RGB="255,96,255"
export ACT3_RGB="104,255,214"
export ACCENT_RGB="232,254,150"
export SUCCESS_RGB="18,199,143"
export ERR_RGB="235,66,104"
export WARNING_RGB="232,254,150"
export INFO_RGB="0,164,255"
export KEYWORD_RGB="107,80,255"
export FUNC_RGB="255,96,255"
export STR_RGB="104,255,214"
export CONST_RGB="0,164,255"
export COMMENT_RGB="133,131,146"
export TYPE_RGB="194,89,255"
export VAR_RGB="245,239,52"
export BORDER_RGB="107,80,255"
export BORDER_INACTIVE_RGB="77,76,87"
export HIGHLIGHT_RGB="77,76,87"
export HIGHLIGHT_DIM_RGB="58,57,67"
export CURSOR_RGB="107,80,255"
export SEL_BG_RGB="107,80,255"
export SEL_FG_RGB="241,239,239"

# Legacy variable names for compatibility with existing configs
export CBLOCK="$BASE"
export CBLOCK_BG="$BG2"
export CBLOCK_LN="$BASE_DIM"
export CBLOCK_LN_BG="$BG3"
export COMP="$ACT2"
export TTIP="$BASE"
export TTIP_SL="$BASE_DIM"
export TTIP_BG="$BG3"

# Usage: Source this file in your bash scripts with: source colors.env
xcalc*ti.button55.foreground: rgb:c/c/c

xcalc*ti.button3.label: sqrt
xcalc*ti.button21.label: \434
xcalc*ti.button35.label: \367

! Font rendering settings
Xft.dpi: 192
Xft.antialias: true
Xft.rgba: rgb
Xft.hinting: true
Xft.hintstyle: hintslight
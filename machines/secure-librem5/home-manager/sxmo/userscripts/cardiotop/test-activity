#!/usr/bin/env python3
"""Minimal test script to debug data flow from cardiotop-device"""
import sys
import subprocess
import json

print("TEST: Starting minimal cardiotop-activity test", file=sys.stderr)
print("TEST: Running cardiotop-device...", file=sys.stderr)

# Start the device process
device_cmd = ["./cardiotop-device", "--profile", "Polar1"]
print(f"TEST: Command: {' '.join(device_cmd)}", file=sys.stderr)

try:
    proc = subprocess.Popen(
        device_cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        bufsize=1,  # Line buffered
        universal_newlines=True
    )
    
    print("TEST: Process started, waiting for data...", file=sys.stderr)
    
    # Read line by line
    line_count = 0
    while True:
        line = proc.stdout.readline()
        if not line:
            print("TEST: EOF reached", file=sys.stderr)
            break
            
        line_count += 1
        line = line.strip()
        print(f"TEST: Got line #{line_count}: {line[:100]}...", file=sys.stderr)
        
        # Try to parse as JSON
        try:
            data = json.loads(line)
            print(f"TEST: Successfully parsed JSON with keys: {list(data.keys())}", file=sys.stderr)
            # Output the data
            print(json.dumps(data), flush=True)
        except json.JSONDecodeError as e:
            print(f"TEST: JSON parse error: {e}", file=sys.stderr)
            print(f"TEST: Raw line was: {line}", file=sys.stderr)
        
        # Check stderr
        stderr_line = proc.stderr.readline()
        if stderr_line:
            print(f"TEST: Device stderr: {stderr_line.strip()}", file=sys.stderr)
            
except Exception as e:
    print(f"TEST: Exception: {e}", file=sys.stderr)
    import traceback
    traceback.print_exc(file=sys.stderr)
finally:
    if 'proc' in locals():
        proc.terminate()
        print("TEST: Process terminated", file=sys.stderr)
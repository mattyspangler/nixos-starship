#!/usr/bin/env python3
"""
Cardiotop Activity - The Orchestrator

Reads an activity profile to determine which device streams to monitor,
launches the necessary `cardiotop-device` processes, aggregates their
JSON data streams in a non-blocking way, and processes the combined
data through stateful activity plugins.
"""

import argparse
import json
import os
import select
import subprocess
import sys
import time
from pathlib import Path
from typing import Dict, Any, List, Optional
import importlib

# --- Globals ---
VERBOSE = False

# --- Core Functions ---

def log(message: str, error: bool = False):
    """
    Conditionally prints a log message to stderr.

    Args:
        message (str): The message to log.
        error (bool): If True, the message is always printed as an error.
    """
    if VERBOSE or error:
        timestamp = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
        print(f"[{timestamp}] [ACTIVITY] {message}", file=sys.stderr, flush=True)

def find_and_load_profile(profile_name: str) -> Dict[str, Any]:
    """
    Finds and loads an activity profile by searching in user and system directories.

    It checks the user's config directory first, allowing users to override
    the default system profiles.

    Args:
        profile_name (str): The name of the profile to load (e.g., "default").

    Returns:
        Dict[str, Any]: The loaded profile configuration as a dictionary.

    Raises:
        FileNotFoundError: If the profile is not found in any search path.
    """
    user_config_dir = Path.home() / ".config" / "cardiotop" / "activity-profiles"
    system_config_dir = Path(__file__).parent / "activity-profiles"

    # Ensure user directory exists
    user_config_dir.mkdir(parents=True, exist_ok=True)

    search_paths = [
        user_config_dir / f"{profile_name}.json",
        system_config_dir / f"{profile_name}.json"
    ]

    for profile_path in search_paths:
        if profile_path.is_file():
            log(f"Loading activity profile from: {profile_path}")
            with open(profile_path, 'r') as f:
                return json.load(f)

    raise FileNotFoundError(f"Activity profile '{profile_name}.json' not found in any search path.")

def load_activity_plugins(plugin_configs: Dict[str, Dict[str, Any]]) -> List[Any]:
    """
    Dynamically loads and initializes activity plugins from a dictionary.

    Args:
        plugin_configs (Dict[str, Dict[str, Any]]): A dictionary of plugin
            configurations from the activity profile. The key is the plugin name
            and the value is its configuration dictionary.

    Returns:
        List[Any]: A list of initialized plugin instances.
    """
    plugins = []
    plugin_dir = Path(__file__).parent / "plugins" / "activity"
    if str(plugin_dir) not in sys.path:
        sys.path.insert(0, str(plugin_dir))

    for name, config in plugin_configs.items():
        try:
            module = importlib.import_module(name)
            plugin_instance = module.ActivityPlugin(config)
            plugins.append(plugin_instance)
            log(f"Successfully loaded activity plugin '{name}'.")
        except Exception as e:
            log(f"Failed to load activity plugin '{name}': {e}", error=True)
    return plugins

def get_device_profiles_to_launch(profile_config: List[str]) -> Dict[str, str]:
    """
    Resolves the list of device profiles to launch.

    - If the wildcard "*" is used, it launches all profiles in the user's
      `~/.config/cardiotop/device-profiles` directory.
    - If specific profile names are provided, it searches for them first in
      the user's directory, then in the system's `device-templates` directory.

    Args:
        profile_config (List[str]): The `device_profiles` list from the
            activity profile.

    Returns:
        Dict[str, str]: A dictionary mapping the stream name to the profile name.
    """
    script_dir = Path(__file__).parent
    user_profiles_dir = Path.home() / ".config" / "cardiotop" / "device-profiles"
    system_templates_dir = script_dir / "device-templates"

    # Ensure user directory exists
    user_profiles_dir.mkdir(parents=True, exist_ok=True)

    if profile_config == ["*"]:
        log(f"Wildcard detected. Launching all profiles in {user_profiles_dir}")
        return {p.stem: p.stem for p in user_profiles_dir.glob("*.json")}

    profiles_to_launch = {}
    for p_name in profile_config:
        user_path = user_profiles_dir / f"{p_name}.json"
        system_path = system_templates_dir / f"{p_name}.json"

        if user_path.is_file():
            profiles_to_launch[p_name] = p_name
            log(f"Found user device profile: {user_path}")
        elif system_path.is_file():
            profiles_to_launch[p_name] = p_name
            log(f"Found system device template: {system_path}")
        else:
            log(f"Specified device profile '{p_name}' not found in user or system directories. Skipping.", error=True)

    return profiles_to_launch

def launch_device_processes(profiles: Dict[str, str]) -> Dict[int, Dict[str, Any]]:
    """
    Launches a `cardiotop-device` subprocess for each specified profile.

    Args:
        profiles (Dict[str, str]): A dictionary mapping stream names to
            device profile names.

    Returns:
        Dict[int, Dict[str, Any]]: A dictionary mapping each process's stdout/stderr
            file descriptor to a dict containing the process object, stream name,
            and a buffer for partial line reads.
    """
    processes = {}
    device_script = Path(__file__).parent / "cardiotop-device"
    if not device_script.is_file():
        raise FileNotFoundError("`cardiotop-device` script not found.")

    for stream_name, profile_name in profiles.items():
        cmd = [str(device_script), "--profile", profile_name]
        log(f"Launching stream '{stream_name}': {' '.join(cmd)}")
        try:
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            processes[proc.stdout.fileno()] = {"process": proc, "stream_name": stream_name, "buffer": ""}
            processes[proc.stderr.fileno()] = {"process": proc, "stream_name": f"{stream_name}_stderr", "buffer": ""}
        except Exception as e:
            log(f"Failed to launch process for profile '{profile_name}': {e}", error=True)
    return processes

def process_aggregated_data(data: Dict[str, Any], plugins: List[Any]) -> Dict[str, Any]:
    """
    Runs the aggregated data object through all loaded activity plugins.

    Args:
        data (Dict[str, Any]): The aggregated data object for a single timestamp,
            containing the nested `devices` dictionary.
        plugins (List[Any]): The list of initialized plugin instances.

    Returns:
        Dict[str, Any]: The data object, now with an `activity` key containing
            the combined results from all plugins.
    """
    data["activity"] = {}
    for plugin in plugins:
        try:
            plugin_result = plugin.process(data)
            if plugin_result and isinstance(plugin_result, dict):
                data["activity"].update(plugin_result)
        except Exception as e:
            log(f"Error processing plugin '{plugin.__class__.__name__}': {e}", error=True)
    return data

# --- Main Orchestration Loop ---

def main():
    """Main function to set up and run the orchestrator."""
    global VERBOSE
    parser = argparse.ArgumentParser(description="Cardiotop Activity Orchestrator")
    parser.add_argument("--profile", default="default", help="The activity profile to use.")
    parser.add_argument("--verbose", action="store_true", help="Enable detailed logging to stderr.")
    args = parser.parse_args()
    VERBOSE = True # Always on for debugging

    log("--- Cardiotop Activity Orchestrator Starting ---")

    try:
        activity_profile = find_and_load_profile(args.profile)
        plugins = load_activity_plugins(activity_profile.get("plugins", []))
        device_profiles_config = activity_profile.get("device_profiles", [])
        output_interval = float(activity_profile.get("output_interval", 1.0))

        profiles_to_launch = get_device_profiles_to_launch(device_profiles_config)
        if not profiles_to_launch:
            log("No valid device profiles to launch. Exiting.", error=True)
            sys.exit(1)

        procs_by_fd = launch_device_processes(profiles_to_launch)
        fds = list(procs_by_fd.keys())
        
        data_buffer = {} # {timestamp: aggregated_data}
        last_output_time = time.time()

        while fds:
            # Use select for non-blocking I/O on all subprocess pipes
            readable, _, _ = select.select(fds, [], [], output_interval)
            
            for fd in readable:
                line = os.read(fd, 1024).decode('utf-8')
                if not line: # EOF
                    fds.remove(fd)
                    continue

                info = procs_by_fd[fd]
                info["buffer"] += line
                
                # Process complete lines from the buffer
                while '\n' in info["buffer"]:
                    complete_line, info["buffer"] = info["buffer"].split('\n', 1)
                    stream_name = info["stream_name"]

                    if stream_name.endswith("_stderr"):
                        # Always treat stderr from a child process as an error to ensure it's logged,
                        # regardless of the --verbose flag. This is critical for debugging.
                        log(f"[{stream_name.replace('_stderr', '')} ERR] {complete_line.strip()}", error=True)
                        continue

                    try:
                        data = json.loads(complete_line)
                        ts = data.get("timestamp", int(time.time()))
                        
                        # Aggregate data by timestamp
                        if ts not in data_buffer:
                            data_buffer[ts] = {"timestamp": ts, "devices": {}}
                        data_buffer[ts]["devices"][stream_name] = data

                    except json.JSONDecodeError:
                        log(f"Received non-JSON data from '{stream_name}': {complete_line[:100]}")

            # Process and output data based on the interval
            now = time.time()
            if now - last_output_time >= output_interval and data_buffer:
                latest_ts = max(data_buffer.keys())
                aggregated_data = data_buffer.pop(latest_ts)
                
                final_data = process_aggregated_data(aggregated_data, plugins)
                try:
                    print(json.dumps(final_data), flush=True)
                except BrokenPipeError:
                    log("Consumer closed the pipe. Exiting gracefully.", error=True)
                    # Break the loop to proceed to the finally block for cleanup
                    break
                
                # Clean up old buffer entries
                data_buffer = {t: d for t, d in data_buffer.items() if t > latest_ts}
                last_output_time = now

    except FileNotFoundError as e:
        log(f"A required file was not found: {e}", error=True)
        sys.exit(1)
    except Exception as e:
        log(f"An unexpected error occurred: {e}", error=True)
        import traceback
        log_file = Path(__file__).parent / "cardiotop-activity-crash.log"
        with open(log_file, "w") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] An unexpected error occurred: {e}\n")
            traceback.print_exc(file=f)
        traceback.print_exc(file=sys.stderr)
        sys.exit(1)
    finally:
        log("--- Cardiotop Activity Orchestrator Shutting Down ---")
        # Terminate any remaining subprocesses
        if 'procs_by_fd' in locals():
            for info in procs_by_fd.values():
                info["process"].terminate()

if __name__ == "__main__":
    main()
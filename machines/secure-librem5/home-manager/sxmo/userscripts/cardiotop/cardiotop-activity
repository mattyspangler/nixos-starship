#!/usr/bin/env python

"""
Cardiotop activity aggregator.

Merges data streams from multiple cardiotop-device instances into a single,
unified stream of line-delimited JSON.
"""

import argparse
import asyncio
import json
import os
import sys
import shutil

async def read_stream(stream, stream_name, queue):
    """Read lines from a stream and put them into a queue."""
    while True:
        line = await stream.readline()
        if not line:
            break
        try:
            data = json.loads(line)
            data["stream_name"] = stream_name
            await queue.put(data)
        except json.JSONDecodeError:
            print(f"Warning: Could not decode JSON from stream '{stream_name}': {line.decode().strip()}", file=sys.stderr)
            continue

async def main():
    """
    Main entry point for the activity aggregator.

    Parses args, loads the specified activity profile, and then launches and
    merges the output of the specified device profiles.
    """
    parser = argparse.ArgumentParser(description="A multi-device data stream aggregator for Cardiotop.")
    parser.add_argument("--profile", required=True, dest="profile_name", help="The name or path of the activity profile to use.")
    args = parser.parse_args()

    script_dir = os.path.dirname(os.path.realpath(__file__))
    try:
        profile_name = args.profile_name
        config_dir = os.path.expanduser("~/.config/cardiotop/activity-profiles")

        if not profile_name.endswith(".json"):
            profile_path = os.path.join(config_dir, f"{profile_name}.json")
        else:
            profile_path = profile_name

        with open(profile_path, "r") as f:
            profile = json.load(f)
    except FileNotFoundError:
        # If the profile wasn't found, try to copy it from the templates directory.
        template_path = os.path.join(script_dir, "activity-templates", f"{profile_name}.json")
        
        if not profile_name.endswith(".json") and os.path.exists(template_path):
            print(f"Info: Profile '{profile_name}' not found. Copying from template.", file=sys.stderr)
            try:
                os.makedirs(config_dir, exist_ok=True)
                shutil.copy(template_path, profile_path)
                print(f"Info: Created new profile at '{profile_path}'.", file=sys.stderr)
                print("      Please edit this file with your personal data for accurate results.", file=sys.stderr)
                # Now try to load it again
                with open(profile_path, "r") as f:
                    profile = json.load(f)
            except Exception as e:
                print(f"Error: Could not create profile from template: {e}", file=sys.stderr)
                return
        else:
            print(f"Error: Profile file not found for '{args.profile_name}'. Looked at: '{profile_path}'.", file=sys.stderr)
            return

    except json.JSONDecodeError:
        print(f"Error: Could not decode JSON from profile file '{profile_path}'. Check for syntax errors.", file=sys.stderr)
        return
    cardiotop_device_script = os.path.join(script_dir, "cardiotop-device")

    device_profiles = profile.get("device_profiles", [])
    if not device_profiles:
        print("Warning: No device profiles specified in the activity profile.", file=sys.stderr)
        return

    # Special case for the "*" wildcard
    if device_profiles == ["*"]:
        device_profiles_dir = os.path.expanduser("~/.config/cardiotop/device-profiles")
        try:
            device_profiles = [f.replace(".json", "") for f in os.listdir(device_profiles_dir) if f.endswith(".json")]
        except FileNotFoundError:
            print(f"Error: Device profiles directory not found at '{device_profiles_dir}'.", file=sys.stderr)
            device_profiles = []

    procs = []
    for profile_name in device_profiles:
        proc = await asyncio.create_subprocess_exec(
            cardiotop_device_script,
            "--profile",
            profile_name,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )
        procs.append((proc, profile_name))

    # Create a queue to hold the merged data
    merged_queue = asyncio.Queue()

    # Start the stream readers
    reader_tasks = [read_stream(proc.stdout, name, merged_queue) for proc, name in procs]

    # Load activity plugins
    activity_plugins = []
    plugin_dir = os.path.join(script_dir, "plugins", "activity")
    if os.path.isdir(plugin_dir):
        sys.path.append(plugin_dir)

    for plugin_info in profile.get("activity_plugins", []):
        if isinstance(plugin_info, str):
            # Support old format for now
            module_name = plugin_info
            config = {}
        elif isinstance(plugin_info, dict):
            module_name = plugin_info.get("name")
            config = plugin_info.get("config", {})
        else:
            continue

        if not module_name:
            continue

        try:
            module = importlib.import_module(module_name)
            activity_plugins.append(module.get_plugin(config))
        except ImportError as e:
            print(f"Warning: Could not import activity plugin '{module_name}': {e}", file=sys.stderr)
            continue
        except AttributeError:
            print(f"Warning: Activity plugin '{module_name}' is missing the 'get_plugin(config)' function.", file=sys.stderr)
            continue

    # Main processing loop
    while True:
        try:
            data = await asyncio.wait_for(merged_queue.get(), timeout=1.0)
            
            # Run the data through the activity plugin pipeline
            for plugin in activity_plugins:
                data = plugin.process(data)
                if data is None:
                    break # Plugin decided to drop this data point
            
            if data is not None:
                print(json.dumps(data), flush=True)

        except asyncio.TimeoutError:
            # Check if all subprocesses have exited
            if all(proc.returncode is not None for proc, _ in procs):
                break
    
    # Finalize plugins
    for plugin in activity_plugins:
        if hasattr(plugin, "finalize"):
            plugin.finalize()

    # Cancel the reader tasks
    for task in reader_tasks:
        task.cancel()
    await asyncio.gather(*reader_tasks, return_exceptions=True)

    # Wait for all processes to finish
    for proc, name in procs:
        await proc.wait()
        stderr = await proc.stderr.read()
        if stderr:
            print(f"Stderr from {name}:\n{stderr.decode()}", file=sys.stderr)


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nStopping Cardiotop Activity.", file=sys.stderr, flush=True)
#!/usr/bin/env python
"""
A Textual TUI for Cardiotop.
"""

import asyncio
import json
import os
import shlex
from textual.app import App, ComposeResult
from textual.containers import Vertical
from textual.widgets import Header, Footer, Static

class DeviceWidget(Static):
    """A widget to display data from a single device."""

    def __init__(self, profile: dict, **kwargs) -> None:
        """Initializes the widget."""
        super().__init__(**kwargs)
        self.profile = profile
        self.display_widgets = {}

    def compose(self) -> ComposeResult:
        """Creates the UI for the widget."""
        yield Static(self.profile["display"]["title"])
        for key, label in self.profile["display"]["keys"].items():
            widget = Static(f"{label}: --", id=f"display_{key}")
            self.display_widgets[key] = widget
            yield widget
        yield Static("-" * 30)

    def update_data(self, data: dict) -> None:
        """Updates the widget with new data."""
        for key, widget in self.display_widgets.items():
            if key in data:
                label = self.profile["display"]["keys"][key]
                widget.update(f"{label}: {data[key]}")

class CardiotopTUI(App):
    """The main TUI application."""

    BINDINGS = [("q", "quit", "Quit")]

    def __init__(self, profiles: list[str], **kwargs) -> None:
        """Initializes the TUI."""
        super().__init__(**kwargs)
        self.profiles = profiles
        self.device_widgets = {}

    def compose(self) -> ComposeResult:
        """Creates the main layout."""
        yield Header()
        yield Vertical(id="device_container")
        yield Footer()

    async def on_mount(self) -> None:
        """Starts a background worker for each profile."""
        for profile_path in self.profiles:
            self.run_worker(self.run_profile(profile_path))

    async def run_profile(self, profile_path: str) -> None:
        """Runs and manages a `cardiotop` subprocess for a single profile."""
        try:
            if not os.path.isabs(profile_path):
                script_dir = os.path.dirname(os.path.realpath(__file__))
                profile_path = os.path.join(script_dir, profile_path)
            with open(profile_path, "r") as f:
                profile = json.load(f)
        except FileNotFoundError:
            self.exit(f"Error: Profile file not found at '{profile_path}'.")
            return
        except json.JSONDecodeError:
            self.exit(f"Error: Could not decode JSON from profile file '{profile_path}'.")
            return

        script_dir = os.path.dirname(__file__)
        cardiotop_path = os.path.join(script_dir, "cardiotop")
        # Both scripts now use the --profile argument for consistency.
        command = f"{shlex.quote(cardiotop_path)} --profile {shlex.quote(profile_path)}"
        proc = await asyncio.create_subprocess_shell(
            command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )

        if proc.stdout:
            display_name = profile["display"]["title"]
            widget = DeviceWidget(profile=profile)
            self.device_widgets[display_name] = widget
            await self.query_one("#device_container").mount(widget)

            while True:
                line = await proc.stdout.readline()
                if not line:
                    break
                try:
                    data = json.loads(line)
                    # The data is now expected to be a simple, flat dictionary.
                    widget.update_data(data)

                except json.JSONDecodeError:
                    # This can happen if the subprocess is interrupted, so we just continue
                    continue
                except KeyError as e:
                    # This indicates a mismatch between the profile and the data
                    self.exit(f"Error: Key {e} not found in data from profile '{profile_path}'.")
                    continue

    def action_quit(self) -> None:
        """Quit the application."""
        self.exit()

def find_profiles() -> list[str]:
    """Finds all profile files in standard locations."""
    profiles = []
    # The user's config directory
    user_config_dir = os.path.expanduser("~/.config/cardiotop/profiles")
    # The script's local profiles directory
    if os.path.isdir(user_config_dir):
        for filename in os.listdir(user_config_dir):
            if filename.endswith(".json"):
                profiles.append(os.path.join(user_config_dir, filename))
    
    return profiles

if __name__ == "__main__":
    import argparse

    parser = argparse.ArgumentParser(description="A heart rate monitor TUI.")
    parser.add_argument("--profile", dest="profiles", action="append", help="A profile file to use. Can be specified multiple times. If not provided, all profiles in standard locations will be loaded.")
    args = parser.parse_args()

    profiles_to_run = args.profiles or find_profiles()

    if not profiles_to_run:
        print("No profiles found. Please specify a profile with --profile or create one using the 'cardiotop' menu.")
        exit(1)

    app = CardiotopTUI(profiles=profiles_to_run)
    app.run()

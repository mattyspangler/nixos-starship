#!/usr/bin/env python

"""
Cardiotop data provider.

Connects to a BLE heart rate device, processes the data through pluggable
device plugin modules, and streams the result as JSON to stdout.
"""

import argparse
import asyncio
import importlib
import json
import os
import sys

async def main():
    """
    Main entry point for the data provider.

    Parses args, loads the specified profile, loads the device and device plugin
    modules, and then loops forever, streaming processed data to stdout.
    """
    parser = argparse.ArgumentParser(description="A heart rate monitor data provider.")
    parser.add_argument("--profile", required=True, dest="profile_name", help="The name or path of the profile to use.")
    args = parser.parse_args()
   
    try:
        profile_stem = args.profile_name.removesuffix(".json")

        # Define search paths for device profiles
        script_dir = os.path.dirname(os.path.realpath(__file__))
        system_profiles_dir = os.path.join(script_dir, "device-templates")
        user_profiles_dir = os.path.expanduser("~/.config/cardiotop/device-profiles")

        search_paths = [
            os.path.join(user_profiles_dir, f"{profile_stem}.json"),
            os.path.join(system_profiles_dir, f"{profile_stem}.json")
        ]

        profile_path = None
        for path in search_paths:
            if os.path.isfile(path):
                profile_path = path
                break
        
        if not profile_path:
            raise FileNotFoundError(f"Device profile '{profile_name}.json' not found in any search path.")

        with open(profile_path, "r") as f:
            profile = json.load(f)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        return
    except json.JSONDecodeError:
    	print(f"Error: Could not decode JSON from profile file '{profile_path}'. Check for syntax errors.", file=sys.stderr)
    	return

    try:
    	   module_name = profile["module_name"]
    	   device_module = importlib.import_module(f"devices.{module_name}")
    except KeyError:
    	   print("Error: Profile is missing the required 'module_name' key.", file=sys.stderr)
    	   return
    except ImportError:
    	   print(f"Error: Could not import device module '{module_name}'. Check if the module exists and is correctly named.", file=sys.stderr)
    	   return

    device_stream = device_module.get_device_stream(profile)

    device_plugin_modules = []
    for plugin_config in profile.get("device_plugins", []):
        module_name = plugin_config.get("module_name")
        config = plugin_config.get("config", {})
        if not module_name:
            print("Warning: Skipping device plugin with no 'module_name' specified.", file=sys.stderr)
            continue
        try:
            module = importlib.import_module(f"plugins.device.{module_name}")
            # Pass the config to the stats provider
            device_plugin_modules.append(module.get_stats_provider(config))
        except ImportError as e:
            print(f"Warning: Could not import device plugin '{module_name}': {e}", file=sys.stderr)
            continue
        except AttributeError:
            print(f"Warning: Device plugin '{module_name}' is missing the 'get_stats_provider' function.", file=sys.stderr)
            continue

    polling_rate = profile.get("polling_rate", 1.0)
    async for data in device_stream:
        for mod in device_plugin_modules:
            mod.update(data)
            data.update(mod.report())
        
        print(json.dumps(data), flush=True)
        # The 'async for' loop naturally waits for the next data packet from the
        # device stream. Adding an extra sleep here can interfere with the
        # underlying BLE library's event loop, causing connection timeouts.
        # The polling rate is effectively determined by how often the device
        # sends data.
        pass


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("\nStopping Cardiotop.", file=sys.stderr, flush=True)

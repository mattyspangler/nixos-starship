#!/usr/bin/env python
import os
import json
import sys
import shutil
import importlib

def create_profile(device_name: str, address: str, model_name: str, module_name: str, profile_name: str):
    """
    Creates a new user profile from a template.
    """
    script_dir = os.path.dirname(os.path.realpath(__file__))
    # Add script's dir to path to allow importing from 'devices'
    sys.path.insert(0, script_dir)

    try:
        module = importlib.import_module(f"devices.{module_name}")
        default_profile_name = module.DEFAULT_PROFILE_TEMPLATE
    except (ImportError, AttributeError) as e:
        print(f"Error: Could not load module '{module_name}'.\n{e}", file=sys.stderr)
        sys.exit(1)

    default_profile_path = os.path.join(script_dir, "device-templates", default_profile_name)

    if not os.path.exists(default_profile_path):
        print(f"Error: Default profile template '{default_profile_name}' not found at '{default_profile_path}'.")
        sys.exit(1)

    device_profile_dir = os.path.expanduser("~/.config/cardiotop/device-profiles")
    os.makedirs(device_profile_dir, exist_ok=True)
    
    new_profile_path = os.path.join(device_profile_dir, f"{profile_name}.json")

    with open(default_profile_path, 'r') as f:
        profile_data = json.load(f)

    # Standardize profile keys
    profile_data["device_name"] = device_name     # Device's advertised name (e.g., "Polar Verity Sense F070A5")
    profile_data["address"] = address             # Device's BLE address
    profile_data["model_name"] = model_name       # Human-readable model name (e.g., "Polar Verity Sense")
    profile_data["module_name"] = module_name     # cardiotop-device module for this model (e.g., "polar_sense")
    profile_data["display"]["title"] = device_name # Use advertised name for TUI title

    with open(new_profile_path, 'w') as f:
        json.dump(profile_data, f, indent=2)
    
    print(f"Profile created at {new_profile_path}")

if __name__ == "__main__":
    if len(sys.argv) != 6:
        print("Usage: _create_device_profile <device_name> <address> <model_name> <module_name> <profile_name>", file=sys.stderr)
        sys.exit(1)

    create_profile(sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])